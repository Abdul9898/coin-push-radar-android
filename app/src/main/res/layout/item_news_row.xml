<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- Source and Sentiment Header -->
    <LinearLayout
        android:id="@+id/ll_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_news_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Binance News"
            android:textColor="@color/gold_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:text="•"
            android:textColor="@color/passive_gray"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_news_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="15m ago"
            android:textColor="@color/passive_gray"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_sentiment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_green"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="BULLISH"
            android:textColor="@color/up_text_color"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- News Headline -->
    <TextView
        android:id="@+id/tv_news_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="3dp"
        android:maxLines="3"
        android:text="Bitcoin breaks new local high following massive spot ETF inflows across global exchanges"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/ll_meta" />

    <!-- News Body snippet -->
    <TextView
        android:id="@+id/tv_news_snippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="2"
        android:text="Market sentiment surges into extreme greed as on-chain liquidity indicators flash sustained momentum signals."
        android:textColor="@color/passive_gray"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tv_news_title" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/line_color"
        app:layout_constraintTop_toBottomOf="@id/tv_news_snippet" />

</androidx.constraintlayout.widget.ConstraintLayout>
