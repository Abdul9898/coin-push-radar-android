<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0D14"
    android:paddingBottom="20dp">

    <!-- Top Drag Handle -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Dialog Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_dialog_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/drag_handle">

        <TextView
            android:id="@+id/tv_detail_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="1000PEPE / USDT"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_detail_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Pepe Linear Perpetual"
            android:textColor="@color/passive_gray"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_symbol" />

        <TextView
            android:id="@+id/tv_detail_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="$0.0000213"
            android:textColor="@color/title_color"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_detail_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_pill_green"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="+8.45%"
            android:textColor="@color/up_text_color"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_price" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Key Stats Row -->
    <LinearLayout
        android:id="@+id/ll_stats_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#101520"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/cl_dialog_header">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24h High"
                android:textColor="@color/passive_gray"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_detail_high"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.000022"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24h Low"
                android:textColor="@color/passive_gray"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_detail_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.000019"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24h Turnover"
                android:textColor="@color/passive_gray"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_detail_turnover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$142.5M"
                android:textColor="@color/gold_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Interval Tabs -->
    <LinearLayout
        android:id="@+id/ll_dialog_intervals"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:background="#07090E"
        android:orientation="horizontal"
        android:weightSum="7"
        app:layout_constraintTop_toBottomOf="@id/ll_stats_row">

        <TextView
            android:id="@+id/tv_dialog_int_1s"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1s"
            android:textColor="@color/passive_gray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_dialog_int_1m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1m"
            android:textColor="@color/passive_gray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_dialog_int_5m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="5m"
            android:textColor="@color/passive_gray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_dialog_int_15m"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="15m"
            android:textColor="@color/title_color"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_dialog_int_1h"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1h"
            android:textColor="@color/passive_gray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_dialog_int_4h"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="4h"
            android:textColor="@color/passive_gray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_dialog_int_1d"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1d"
            android:textColor="@color/passive_gray"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- In-App Candlestick Chart WebView -->
    <WebView
        android:id="@+id/wv_detail_chart"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@id/ll_dialog_intervals" />

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:id="@+id/ll_dialog_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/wv_detail_chart">

        <ImageView
            android:id="@+id/iv_detail_alert_toggle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/checked" />

        <TextView
            android:id="@+id/tv_detail_alert_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Alerts Active for this coin"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_detail_close"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_search_input"
            android:text="Close"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
