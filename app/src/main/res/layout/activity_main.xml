<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/black"
        android:paddingHorizontal="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- App Brand Title -->
        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:text="COIN PUSH"
            android:textColor="@color/title_color"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Unrestricted VIP Badge -->
        <TextView
            android:id="@+id/tv_vip_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_gold"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="VIP 🔓"
            android:textColor="@color/title_color"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_app_title"
            app:layout_constraintStart_toEndOf="@id/tv_app_title"
            app:layout_constraintTop_toTopOf="@id/tv_app_title" />

        <!-- Search Bar Container (toggleable) -->
        <EditText
            android:id="@+id/edt_search"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_search_input"
            android:hint="@string/search"
            android:imeOptions="actionSearch"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/passive_gray"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/iv_search_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_search_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Close search"
            android:padding="4dp"
            android:src="@drawable/close"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cl_subAll"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Search Icon Button -->
        <ImageView
            android:id="@+id/iv_search_toggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Search"
            android:padding="4dp"
            android:src="@drawable/search_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cl_subAll"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Global "Activate All" Alert Toggle (Completely Unlocked!) -->
        <LinearLayout
            android:id="@+id/cl_subAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/subAll"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Activate all alerts"
                android:src="@drawable/checked" />

            <TextView
                android:id="@+id/tv_activate_all_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@string/activate_all"
                android:textColor="@color/passive_gray"
                android:textSize="9sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/top_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line_color"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />


    <!-- TAB 1: COINS (All Bybit Symbols) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_coins"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/nav_view"
        app:layout_constraintTop_toBottomOf="@id/top_divider">

        <!-- Column Titles -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_column_headers"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:paddingHorizontal="14dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/coins"
                android:textColor="@color/passive_gray"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="90dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/price"
                android:textColor="@color/passive_gray"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_header_alerts"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/daily"
                android:textColor="@color/passive_gray"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_header_alerts"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_header_alerts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/alerts"
                android:textColor="@color/passive_gray"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/divier_headers"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@id/cl_column_headers" />

        <!-- Swipe Refresh List -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_coins"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divier_headers">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/allSymbolsRV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/pb_coins"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/title_color"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TAB 2: MOVERS (Top Gainers & Losers) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_movers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/nav_view"
        app:layout_constraintTop_toBottomOf="@id/top_divider">

        <!-- Sub Tabs: Gainers / Losers -->
        <LinearLayout
            android:id="@+id/ll_movers_tabs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#0C1017"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btn_subtab_gainers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Top Gainers"
                android:textColor="@color/up_text_color"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_subtab_losers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Top Losers"
                android:textColor="@color/passive_gray"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:id="@+id/divier_movers"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@id/ll_movers_tabs" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_movers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divier_movers">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/moversRV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TAB 3: NEWS (Breaking Crypto News) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_news"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/nav_view"
        app:layout_constraintTop_toBottomOf="@id/top_divider">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_news"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/newsRV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TAB 4: ALERTS (Real-Time Momentum & Breakout Signals) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_alerts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/nav_view"
        app:layout_constraintTop_toBottomOf="@id/top_divider">

        <!-- Filter Sub-header -->
        <HorizontalScrollView
            android:id="@+id/hsv_alert_filters"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#0A0E15"
            android:scrollbars="none"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/chip_alert_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_gold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="All Alerts"
                    android:textColor="@color/title_color"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_alert_going_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_green"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="Going Up 🚀"
                    android:textColor="@color/up_text_color"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_alert_break_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_green"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="Breaks Up ⚡"
                    android:textColor="@color/up_text_color"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_alert_squeeze"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_gold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="Squeeze / Movement"
                    android:textColor="@color/title_color"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:id="@+id/divier_alerts"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@id/hsv_alert_filters" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/alertsRV"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divier_alerts" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TAB 5: SETTINGS / PROFILE -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/container_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/nav_view"
        app:layout_constraintTop_toBottomOf="@id/top_divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- VIP Status Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_settings_vip_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="VIP UNRESTRICTED ACCESS"
                    android:textColor="@color/title_color"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_settings_vip_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="• Unlimited Coin Follows (3-coin limit removed)\n• Master Activate All Alerts unlocked\n• Real-Time 1s/1m/15m/1h Candlestick Charts\n• Bybit Linear Perpetual 820+ Pairs &amp; Meme Coins\n• Live On-Screen Popups &amp; System Heads-Up Alerts"
                    android:textColor="@color/passive_gray"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/tv_settings_vip_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill_gold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="LIFETIME UNLOCKED • NO SUBSCRIPTION"
                    android:textColor="@color/title_color"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tv_settings_vip_desc" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Test Alert Trigger Button (Guarantees user can test notifications!) -->
            <Button
                android:id="@+id/btn_test_notification"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill_gold"
                android:fontFamily="sans-serif-medium"
                android:text="🔔 Test Alert Notification (Pop on Screen)"
                android:textColor="@color/title_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Alert Configuration Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Alert Triggers"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Setting 1: Going Up -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Going Up Signals (>3% surge)"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/checked" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line_color" />

                <!-- Setting 2: Breaks Up -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Breaks Up (24h High Breakout)"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/checked" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line_color" />

                <!-- Setting 3: Imminent Movement -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Volatility Squeeze (Imminent Move)"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/checked" />
                </LinearLayout>
            </LinearLayout>

            <!-- App Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="System Info"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Application: Coin Push Radar"
                    android:textColor="@color/passive_gray"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Version: 1.9.7 (Build 2026.11)"
                    android:textColor="@color/passive_gray"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Data Feed: Bybit Linear Perpetual Futures (v5 API)"
                    android:textColor="@color/passive_gray"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pairs Tracked: 829+ USDT Linear Pairs (All Meme Coins)"
                    android:textColor="@color/passive_gray"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav_view"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/tabs_bg"
        app:elevation="8dp"
        app:itemIconSize="26dp"
        app:itemIconTint="@null"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

    <!-- In-App Floating Alert Banner (Rendered on top-most layer) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_alert_popup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:elevation="30dp"
        android:translationZ="30dp"
        android:visibility="gone"
        app:cardBackgroundColor="#131924"
        app:cardCornerRadius="12dp"
        app:cardElevation="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_divider">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <ImageView
                android:id="@+id/iv_popup_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/going_up"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_popup_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-black"
                android:text="🚀 PEPE Going up!"
                android:textColor="@color/title_color"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@id/iv_popup_close"
                app:layout_constraintStart_toEndOf="@id/iv_popup_icon"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_popup_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif"
                android:text="Price: $0.000021 • +8.5% Surge (1h Momentum)"
